{
  "hooks": {
    "enabled": true,
    "events": {
      "SessionStart": [
        {
          "matcher": "startup|resume|clear|compact",
          "hooks": [
            {
              "type": "process",
              "command": "node",
              "args": [
                "${ZCODE_PROJECT_DIR}/.forma/i18n/cli.cjs",
                "gate",
                "--json"
              ],
              "timeoutMs": 15000
            }
          ]
        },
        {
          "matcher": "startup|resume|clear|compact",
          "hooks": [
            {
              "type": "process",
              "command": "node",
              "args": [
                "${ZCODE_PROJECT_DIR}/.forma/i18n/cli.cjs",
                "backlog",
                "--json"
              ],
              "timeoutMs": 15000
            }
          ]
        }
      ],
      "PreToolUse": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "process",
              "command": "node",
              "args": [
                "${ZCODE_PROJECT_DIR}/.zcode/hooks/guard-destructive.cjs"
              ],
              "timeoutMs": 10000
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "process",
              "command": "node",
              "args": [
                "${ZCODE_PROJECT_DIR}/.zcode/hooks/unlock-delete.cjs"
              ],
              "timeoutMs": 10000
            }
          ]
        }
      ]
    }
  },
  "plugins": {
    "enabledPlugins": {
      "spreadsheets@zcode-plugins-official": true,
      "forma-hooks@forma-local": true
    }
  }
}
