{
  "allowList": [
    "tests-fixtures",
    "skill-scripts"
  ],
  "zones": {
    "board-core": {
      "prefixes": [
        "skills/forma/core/board/"
      ]
    },
    "tests-fixtures": {
      "prefixes": [
        "test/"
      ]
    },
    "hooks-spend": {
      "prefixGlobs": [
        "skills/forma/adapters/*/hooks/"
      ],
      "names": [
        "*spend*",
        "*ledger*",
        "*economy*",
        "*subagent-transcript*"
      ]
    },
    "adapters-installers": {
      "prefixes": [
        "skills/forma/adapters/"
      ],
      "names": [
        "*gen-roles*"
      ]
    },
    "skill-scripts": {
      "rest": true
    }
  }
}
